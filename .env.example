# Copy to .env.local and fill in. Never commit real values.
# Every variable here is SERVER-ONLY. Do not rename any of them with a NEXT_PUBLIC_ prefix.

# Which voice speaks for the tutor: "bolna" (default) or "browser" (device voice).
# Any other value turns voice off rather than guessing.
VOICE_PROVIDER=bolna

# Bolna (platform.bolna.ai): API key (starts with "bn-") and the agent's UUID.
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Access code a grown-up types before voice is unlocked.
# Required in production; optional locally (leave empty to skip the code in development).
# Use 12+ random characters. Changing it signs everyone out of voice.
DEMO_ACCESS_CODE=

# Durable rate limiting (Upstash Redis, REST API). Required in production:
# without it the voice route stays off. Locally an in-memory limiter is used if empty.
# The Vercel Upstash integration may inject KV_REST_API_URL / KV_REST_API_TOKEN instead;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional limits (defaults shown).
# VOICE_SESSIONS_PER_CLIENT=6
# VOICE_SESSION_WINDOW_SECONDS=600
# VOICE_SESSIONS_PER_DAY=150

# Optional: extra origins allowed to call the voice routes, comma-separated
# (for example a custom domain in front of Vercel). Same-origin always works.
# VOICE_ALLOWED_ORIGINS=https://littleverse.example
